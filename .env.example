# Local development
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/your_database"
DIRECT_URL="postgresql://your_user:your_password@localhost:5432/your_database"
JWT_SECRET="your_jwt_secret"
PORT=3000

# Docker local
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5433
DOCKER_DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@postgres:5432/your_database_name"